   "source": [
    "import sys\n",
    "import importlib\n",
    "\n",
    "# utils配下のモジュールをすべて再読み込み\n",
    "for module_name, module in list(sys.modules.items()):\n",
    "    if module_name.startswith(\"utils.\"):\n",
    "        importlib.reload(module)\n",
    "        print(f\"✓ {module_name}\")\n",
    "\n",
    "print(\"utils配下のモジュールをすべて再読み込みしました。\")"
   ]
  },
